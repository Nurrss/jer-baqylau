# ─────────────────────────────────────────────────────────────────────────────
# ЖерБақылау — переменные окружения.
# Скопируй в `.env` (он в .gitignore) и заполни. Значения по умолчанию подходят
# для полностью локального запуска: `make up` (PostGIS + Redis в Docker).
# ─────────────────────────────────────────────────────────────────────────────

# local | test | production. В production включаются строгие проверки конфигурации.
ENV=local
LOG_LEVEL=INFO
# true → JSON-логи (для Railway), false → цветные логи для консоли.
LOG_JSON=false
# Публичный адрес API (нужен для вебхука бота и ссылок на файлы при локальном хранилище).
PUBLIC_API_URL=http://localhost:8000

# ── База данных ──────────────────────────────────────────────────────────────
# Локально: PostGIS из docker compose (порт 54322).
# Supabase: Project Settings → Database → Connect → «Session pooler» (порт 5432!):
#   postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://jer:jer@localhost:54322/jer
# Для сервиса api внутри docker compose (по умолчанию — контейнер db). Для Supabase поставь тот же URL, что выше.
# DATABASE_URL_DOCKER=

# ── Redis (FSM-хранилище бота) ───────────────────────────────────────────────
# Локально — контейнер redis. Upstash: rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL=redis://localhost:6379/0
# REDIS_URL_DOCKER=

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Через запятую. На проде — только домен Vercel.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173

# ── Аутентификация инспектора ────────────────────────────────────────────────
# local    → API сам выдаёт JWT по демо-логину ниже (для разработки без Supabase).
# supabase → вход через Supabase Auth, API проверяет JWT проекта.
AUTH_MODE=local
DEMO_INSPECTOR_EMAIL=inspector@jer.kz
DEMO_INSPECTOR_PASSWORD=demo12345
DEMO_INSPECTOR_NAME=Инспектор Демо
# Секрет подписи локальных JWT (только AUTH_MODE=local), ≥32 символов.
LOCAL_JWT_SECRET=local-dev-secret-change-me-please-32b

# Необязательный список почт инспекторов через запятую. Пусто — любой пользователь Supabase Auth проекта.
INSPECTOR_EMAILS=

# Supabase: Project Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# ⚠️ service_role — только бэкенд! Никогда не во фронтенд и не в git.
SUPABASE_SERVICE_ROLE_KEY=
# Нужен только если проект подписывает JWT legacy-секретом (HS256). Для новых ключей (JWKS) — пусто.
SUPABASE_JWT_SECRET=

# Ключ для служебных эндпоинтов (/api/v1/dev/*, e2e_smoke, demo-reset). Сгенерируй:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_KEY=local-service-key

# ── Хранилище фото ───────────────────────────────────────────────────────────
# local → диск (apps/api/.storage), supabase → приватный бакет Supabase Storage.
STORAGE_BACKEND=local
SUPABASE_STORAGE_BUCKET=photos

# ── Telegram-бот ─────────────────────────────────────────────────────────────
# Токен от @BotFather. Для разработки лучше отдельный dev-бот.
TELEGRAM_BOT_TOKEN=
# polling (локально) | webhook (Railway) | disabled
BOT_MODE=disabled
# Секрет вебхука (заголовок X-Telegram-Bot-Api-Secret-Token), обязателен для webhook:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
SIGNALS_PER_HOUR_LIMIT=5
FSM_TIMEOUT_MINUTES=30

# ── Гео ──────────────────────────────────────────────────────────────────────
NOMINATIM_USER_AGENT=JerBaqylau/0.1 (hackathon demo; contact: team@example.com)
# Допустимая область для сигналов: min_lon,min_lat,max_lon,max_lat (Жамбылская область).
REGION_BBOX=69.0,42.2,75.5,45.6

# ── Фоновые задачи ───────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SATELLITE_SCAN_INTERVAL_MINUTES=30

# ── Старт контейнера ─────────────────────────────────────────────────────────
RUN_MIGRATIONS_ON_START=false
SEED_ON_START=false

# ── Фронтенд (apps/web, Vite читает только VITE_*) ───────────────────────────
VITE_API_URL=http://localhost:8000
# Пусто → вход через локальный AUTH_MODE и realtime через поллинг.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
